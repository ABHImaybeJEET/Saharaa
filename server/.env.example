# ==========================================
# SAHARAA DISASTER LOGISTICS - BACKEND CONFIG
# ==========================================

# Server Port
PORT=4000

# Node Environment ('development' | 'production')
NODE_ENV=production

# CORS Allowed Origin (set to your frontend Vercel/Netlify URL in production)
# Example: https://saharaa-disaster-grid.vercel.app
CLIENT_ORIGIN=*

# Optional: Production PostgreSQL / PostGIS Database URL
# Example: postgresql://postgres:password@localhost:5432/saharaa_db
DATABASE_URL=

# Optional: Production Redis Cache & PubSub URL (e.g. Upstash)
# Example: rediss://default:password@your-redis-host.upstash.io:6379
REDIS_URL=

# Optional: Twilio SMS Gateway Integration (for real GSM telephony)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
